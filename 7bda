# Enhancing Customer Experience
customers = {
"Rahul": ["Mobile", "Phone Case"],
"Priya": ["Laptop", "Mouse"],
"Amit": ["Mobile", "Phone Case"]
}

print("Customer Recommendations")

for name, purchases in customers.items():
if "Mobile" in purchases:
print(name, "-> Recommended: Earphones")
elif "Laptop" in purchases:
print(name, "-> Recommended: Laptop Bag")
