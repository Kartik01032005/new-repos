
#include <stdio.h>
#include <omp.h>

int fib(int n) {
    if(n < 2) return n;

    int a, b;

    #pragma omp task shared(a)
    a = fib(n-1);

    #pragma omp task shared(b)
    b = fib(n-2);

    #pragma omp taskwait
    return a+b;
}

int main() {
    omp_set_num_threads(4);

    #pragma omp parallel
    {
        #pragma omp single
        printf("fib(10) = %d\n", fib(10));
    }

    return 0;
}
