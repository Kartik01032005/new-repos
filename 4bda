Cluster analysis using k-means algorithm for a given customer data set (use
Python/R/any other tool).
# Import required libraries
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
# Create customer dataset
data = pd.DataFrame({
'Age': [25, 30, 45, 50, 23, 34, 60, 48, 40, 28],
'SpendingScore': [70, 65, 20, 30, 80, 60, 15, 25, 50, 75]
})
# Create 3 customer clusters
kmeans = KMeans(n_clusters=3, random_state=0)

# Assign each customer to a cluster
data['Cluster'] = kmeans.fit_predict(data)

# Plot the customer clusters
plt.scatter(data.Age, data.SpendingScore, c=data.Cluster)
# Add labels and title
plt.xlabel('Age')
plt.ylabel('Spending Score')
plt.title('Customer Segmentation using K-Means')

# Display the graph
plt.show()
print(data)
