
#include <stdio.h>
#include <mpi.h>

int main(int argc, char *argv[]) {
    int rank, a[3], b[3]={73,2,-16}, count;
    MPI_Status s;

    MPI_Init(&argc,&argv);
    MPI_Comm_rank(MPI_COMM_WORLD,&rank);

    if(rank==0) {
        MPI_Recv(a,3,MPI_INT,MPI_ANY_SOURCE,MPI_ANY_TAG,
                 MPI_COMM_WORLD,&s);
        MPI_Get_count(&s,MPI_INT,&count);

        printf("status.MPI_SOURCE = %d\n",s.MPI_SOURCE);
        printf("status.MPI_TAG = %d\n",s.MPI_TAG);
        printf("status.MPI_ERROR = %d\n",s.MPI_ERROR);
        printf("Receive %d data\n",count);

        for(int i=0;i<count;i++)
            printf("recv[%d] = %d\n",i,a[i]);
    }
    else
        MPI_Send(b,3,MPI_INT,0,10,MPI_COMM_WORLD);

    MPI_Finalize();
    return 0;
}

mpicc send.c -o send
mpirun -np 3 ./send
